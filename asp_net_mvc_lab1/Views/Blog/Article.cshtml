@model asp_net_mvc_lab1.Models.BlogArticleViewModel

<div class="mb-3">
    <a asp-controller="Blog" asp-action="Index">&larr; Back to list</a>
</div>

<article>
    <h2 class="mb-2">@Model.Title</h2>
    <p class="text-muted mb-4">@Model.Description</p>

    <div class="mt-4">
        @Html.Raw(Model.Content)
    </div>
</article>
