{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ASP.NET MVC App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/asp_net_mvc_lab1/bin/${config:msbuildConfiguration}/net8.0/asp_net_mvc_lab1.dll",
      "cwd": "${workspaceFolder}/asp_net_mvc_lab1",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  ]
}
